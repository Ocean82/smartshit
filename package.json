{
  "name": "smartsht",
  "version": "0.1.0",
  "description": "AI-powered spreadsheet for budgets and expenses — chat instead of formulas",
  "author": "Ocean82 (https://github.com/Ocean82)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ocean82/smartshit.git"
  },
  "bugs": {
    "url": "https://github.com/Ocean82/smartshit/issues"
  },
  "homepage": "https://smartsht.com",
  "keywords": [
    "spreadsheet",
    "ai",
    "local-llm",
    "ollama",
    "react",
    "typescript",
    "budget",
    "expenses",
    "formualizer",
    "self-hosted"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "npm run dev --prefix server",
    "dev:all": "npm run dev:server & npm run dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:ci": "eslint . --max-warnings=-1",
    "build": "tsc --noEmit && vite build",
    "build:server": "npm run build --prefix server",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "release:check:v1": "node scripts/v1-release-checklist.mjs",
    "model:copy": "powershell -ExecutionPolicy Bypass -File scripts/copy-model.ps1",
    "model:setup": "npm run setup-model --prefix server"
  },
  "dependencies": {
    "@clerk/react": "^6.11.4",
    "@ocean8219/formualizer": "^0.7.2",
    "@sentry/react": "^10.67.0",
    "@types/uuid": "^10.0.0",
    "clsx": "2.1.1",
    "immer": "^11.1.8",
    "lucide-react": "^1.21.0",
    "quickjs-emscripten": "^0.32.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "3.4.0",
    "uuid": "^14.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.19.3/xlsx-0.19.3.tgz",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vite-plugin-singlefile": "2.3.0",
    "vitest": "^3.2.4"
  }
}
