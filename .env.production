# ─── Frontend Build-Time Variables (baked into the JS bundle by Vite) ─────────
# These MUST be set before running `npm run build` for production.

# Clerk publishable key (LIVE — from https://dashboard.clerk.com → API Keys)
# This is safe to embed in client code — it's a public identifier, not a secret.
# Do NOT put a real pk_live_ value in git. Production deploys inject VITE_* from
# /opt/smartsht/.env (see scripts/deploy.sh mirror_frontend). Locally, copy your
# key into server/.env or export VITE_CLERK_PUBLISHABLE_KEY before `npm run build`.
VITE_CLERK_PUBLISHABLE_KEY=pk_live_YOUR_LIVE_PUBLISHABLE_KEY

# API URL — leave empty for production (same-origin /api via nginx proxy)
VITE_AI_API_URL=

# Sentry DSN for client-side error reporting (optional)
VITE_SENTRY_DSN=

# App version (used in Sentry releases for sourcemap association)
VITE_APP_VERSION=1.0.0
