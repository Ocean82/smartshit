# Dev debug/test scratch scripts at repo root (never ship).
# Scoped prefixes instead of a blanket *.sh, which silently ignored any new
# helper under scripts/ and broke deploys that `git reset --hard` on the server.
/debug-*.sh
/test-*.sh
/tmp-*.sh

# Git worktrees (superpowers isolation)
.worktrees/

