# ─── smartsht Production Server Environment ──────────────────────────────────
# Copy this file to .env on the production server and fill in real values.
# NEVER commit this file with real secrets.

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8787
HOST=127.0.0.1
# Trust the nginx proxy (one hop) so req.ip is the real client IP, not 127.0.0.1.
# Critical for rate limiting to work correctly.
TRUST_PROXY=loopback

# ─── LLM Providers ───────────────────────────────────────────────────────────
# Groq (primary — fast, free tier, recommended for production)
GROQ_API_KEY=gsk_YOUR_PRODUCTION_GROQ_KEY
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter (fallback — broader model selection)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-32b
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# HuggingFace (optional fallback)
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=Qwen/Qwen3-32B
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1

# Ollama (local CPU fallback — only if installed on the server)
OLLAMA_BASE_URL=http://127.0.0.1:11434
SMARTSHIT_MODEL=smartshit
SMARTSHT_ASSIST_MODEL=smartsht-assist

# Provider priority: first available provider wins
LLM_PROVIDER_ORDER=groq,openrouter,ollama

# ─── Clerk Authentication (LIVE keys — clerk.smartsht.com) ────────────────────
# Get these from: https://dashboard.clerk.com → SmartSht app → API Keys
CLERK_SECRET_KEY=sk_live_YOUR_LIVE_CLERK_SECRET_KEY
CLERK_PUBLISHABLE_KEY=pk_live_YOUR_LIVE_CLERK_PUBLISHABLE_KEY

# ─── Stripe Payments (LIVE keys) ─────────────────────────────────────────────
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_YOUR_LIVE_STRIPE_SECRET_KEY
# smartsht Pro $7/mo price ID (created in Stripe dashboard)
STRIPE_PRICE_ID=price_1Tshf9P38C54URjEpxmSrir2
# Webhook signing secret: https://dashboard.stripe.com/webhooks → select endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SIGNING_SECRET

# ─── App URL (used for CORS, redirects, Stripe callbacks) ────────────────────
APP_URL=https://smartsht.com
# CORS: defaults to APP_URL + www variant + localhost. Leave empty for default.
CORS_ORIGIN=

# ─── Database (PostgreSQL on AWS RDS) ─────────────────────────────────────────
DATABASE_URL=postgresql://burntbeatsadmin:YOUR_DB_PASSWORD@burntbeats-db.cgnemc2qmel7.us-east-1.rds.amazonaws.com:5432/burntbeats?sslmode=require

# ─── S3 Storage (workbook cloud save + version history) ───────────────────────
S3_BUCKET=burntbeatz2-storage
S3_REGION=us-east-1
S3_SMARTSHT_PREFIX=smartsht
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY

# ─── Quotas & Limits ─────────────────────────────────────────────────────────
FREE_DAILY_LIMIT=3
WORKBOOK_BODY_LIMIT=25mb
MAX_WORKBOOK_VERSIONS=50
