# Server environment template — copy to `server/.env` (loaded via dotenv at startup).
# A combined frontend+server template also lives at the repo root as `.env.example`.
# Production: the deployed environment file lives at `/opt/smartsht/.env` (see scripts/deploy.sh).

# ─── Core ─────────────────────────────────────────────────────────────────────
# Port/Host the API binds to. Nginx proxies to http://127.0.0.1:8787.
PORT=8787
HOST=127.0.0.1
# Express "trust proxy". Default "loopback" matches the nginx-on-localhost topology
# and is required for correct client IPs (and therefore rate limits). Override with
# a hop count, true/false, or a comma-separated address list.
TRUST_PROXY=loopback
# Public app URL used for redirects, CORS, and Clerk `azp` derivation.
APP_URL=https://smartsht.com

# ─── Clerk ────────────────────────────────────────────────────────────────────
# Backend secret (SmartSht instance — clerk.smartsht.com). Without it, all
# authenticated requests fail; the server refuses to start in production.
CLERK_SECRET_KEY=sk_live_...
# Optional fallback used only when CLERK_PUBLISHABLE_KEY is unset.
CLERK_PUBLISHABLE_KEY=pk_live_...
# JWT `azp` allowlist (optional). Defaults to APP_URL + its www variant + local Vite origins.
# CLERK_AUTHORIZED_PARTIES=https://smartsht.com,https://www.smartsht.com

# ─── Cloud AI providers (optional, recommended for production) ────────────────
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b

OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-32b
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=Qwen/Qwen3-32B
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1

# Priority order for provider failover. Allowed: groq, openrouter, huggingface, ollama.
LLM_PROVIDER_ORDER=groq,openrouter,ollama

# ─── Ollama (fallback — local CPU inference) ──────────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Ollama model id (intentional spelling — do not rename without recreating the model).
# Prod uses Spreadsheet-RL-4B (server/Modelfile.spreadsheet-rl).
SMARTSHIT_MODEL=smartshit
NUM_CTX=8192
NUM_PREDICT=1024

# ─── Quotas & limits ──────────────────────────────────────────────────────────
# Free-tier daily AI request quota per user (persisted in Postgres)
FREE_DAILY_LIMIT=7
# Max cloud workbooks for free users (Pro unlimited). Must match client FREE_CLOUD_WORKBOOK_LIMIT.
FREE_CLOUD_WORKBOOK_LIMIT=1
# Max request body for workbook save routes (full sheet JSON)
WORKBOOK_BODY_LIMIT=25mb
# Historical versions retained per workbook; older ones are pruned from RDS + S3
MAX_WORKBOOK_VERSIONS=50
# Max conversation history sent to cloud providers (Groq, OpenRouter, HuggingFace)
# MAX_HISTORY_CLOUD=10
# Max conversation history sent to local Ollama
# MAX_HISTORY_LOCAL=20
# Minimum cosine similarity for an NLP intent override (0–1)
# INTENT_CONFIDENCE_THRESHOLD=0.6

# ─── Cloud Storage (RDS + S3) — required for cloud save/version history/share ─
# Only DATABASE_URL is used by the server (not DB_HOST / DB_PORT / etc.).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
S3_BUCKET=burntbeatz2-storage
S3_REGION=us-east-1
S3_SMARTSHT_PREFIX=smartsht
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── Stripe (LIVE for production — smartsht Pro) ──────────────────────────────
# STRIPE_PRICE_ID is required for checkout — there is no safe default.
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PRICE_ID=price_1Tshf9P38C54URjEpxmSrir2
STRIPE_PRICE_ID_ANNUAL=price_1U5HPKP38C54URjEl9wtgi5X
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── CORS (optional) ──────────────────────────────────────────────────────────
# Comma-separated allowlist. Defaults to APP_URL + its www variant + localhost
# dev origins. Set to "*" only if you intend a fully public API.
CORS_ORIGIN=